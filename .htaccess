DirectoryIndex index.html index.php
Options -Indexes
RewriteEngine On
RewriteRule ^privacidade/?$ privacidade.html [L]
RewriteRule ^termos/?$ termos.html [L]
RewriteRule ^medicos/?$ medicos.html [L]
RewriteRule ^dentistas/?$ dentistas.html [L]
RewriteRule ^psicologos/?$ psicologos.html [L]
RewriteRule ^advogados/?$ advogados.html [L]
RewriteRule ^avulsos/?$ avulsos.html [L]
RewriteRule ^blog$ /blog/ [R=301,L]
RewriteRule ^blog/$ blog/index.html [L]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog/$1.html [L]

# cache dos assets estáticos (imagens, js, css) — 1 ano; HTML sempre revalidado
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|svg|js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
